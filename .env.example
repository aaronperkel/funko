# ── Database ──────────────────────────────────────────────────────────
# Local dev: a plain SQLite file. Production: a Turso remote URL.
# Same driver, same schema, same migrations — only these two values change.
DATABASE_URL="file:./local.db"
DATABASE_AUTH_TOKEN=""          # leave empty for file:, required for libsql://

# ── Auth ──────────────────────────────────────────────────────────────
ADMIN_PASSWORD="change-me"
AUTH_SECRET=""                  # `openssl rand -base64 32` — signs the session JWT

# ── Visibility ────────────────────────────────────────────────────────
PUBLIC_GALLERY="true"           # false => the whole app requires login

# ── Pricing providers (ALL optional) ──────────────────────────────────
# With none of these set, the app runs fully on manual values.
PRICECHARTING_API_TOKEN=""      # 40-char token. Requires a PAID PriceCharting
                                # subscription: Subscription page -> "API/Download".
EBAY_CLIENT_ID=""               # optional secondary; ACTIVE listings only,
EBAY_CLIENT_SECRET=""           # asking prices, never treated as value.

# ── Cron ──────────────────────────────────────────────────────────────
CRON_SECRET=""                  # bearer guard on /api/cron/refresh-prices

# ── Vercel Blob ───────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""        # auto-injected on Vercel; needed for local uploads
